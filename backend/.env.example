# F1 Help Desk backend — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is not.

# HTTP port the NestJS server listens on
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/f1_helpdesk_db

# JWT signing secret
JWT_SECRET=
