# F1 Help Desk backend — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is not.

# HTTP port the NestJS server listens on
PORT=7676

# Neon (hosted PostgreSQL) pooled connection string (used by Neon CLI tooling) — FAKE placeholder, never a real credential
DATABASE_URL="postgresql://neondb_owner:fake-password-not-a-real-credential@ep-example123456789-c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon (hosted PostgreSQL) DIRECT/unpooled connection string — used by TypeORM (schema work is unreliable through the pooler) — FAKE placeholder, never a real credential
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:fake-password-not-a-real-credential@ep-example123456789-c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret
JWT_SECRET=

# JWT token lifetime (e.g. 7d, 24h, 3600s) — placeholder
JWT_EXPIRES_IN=7d

# Super admin bootstrap seed (PLACEHOLDER values only — never real credentials)
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-placeholder

# Persistent admin-role test account for Milestones 6–11 (local .env only)
TEST_ADMIN_EMAIL=test-admin@example.com
TEST_ADMIN_PASSWORD=change-me-placeholder
